# AgentOps Environment Configuration Template
# Copy this file to .env for local overrides. Do NOT commit .env to source control.

# Application
ENVIRONMENT=development
DEBUG=true

# Security (Change in production)
SECRET_KEY=change-me-to-a-secure-random-secret-in-production-2026

# Database
# Default: async SQLite for zero-setup local dev
DATABASE_URL=sqlite+aiosqlite:///./agentops.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://agentops:password@localhost:5432/agentops

# High-Speed Cache & Coordination (Optional)
# REDIS_URL=redis://localhost:6379/0

# Optional External LLM Provider Keys (Offline mock works without any keys)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
